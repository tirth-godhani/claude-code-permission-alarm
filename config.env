# Permission Timeout & Attention Reminder — configuration.
# Edit this file directly; every value has a sensible default in
# lib/common.sh if you delete or comment out a line.

# Seconds to wait after a permission prompt appears before triggering the
# attention reminder. Cancelled immediately if you respond first.
PERMISSION_TIMEOUT=10

# Path to the MP3/AIFF/WAV played when the timeout fires. Relative paths are
# resolved from the project root. Falls back to a bundled macOS system sound
# if this file is missing, and never crashes if both are missing.
#
# Want a different sound? Steps:
#   1. Grab any short clip, e.g. from https://www.myinstants.com/en/index/in/
#      (open a sound, use its download button to save the mp3).
#   2. Move the downloaded file into assets/, e.g. assets/my-sound.mp3.
#   3. Point this line at it: ATTENTION_SOUND=./assets/my-sound.mp3
#   4. Save this file — no restart needed, the next triggered prompt uses it.
ATTENTION_SOUND=./assets/attention.mp3

# Shell command run when the timeout fires. Runs via `bash -c`, so shell
# syntax (pipes, &&, etc.) works. Leave empty to disable. Runs with a
# COMMAND_TIMEOUT-second watchdog so a hanging command can't leak processes.
# Example: ATTENTION_COMMAND=osascript -e 'display notification "Claude Code is waiting for you" with title "Permission needed"'
ATTENTION_COMMAND=

# Toggle the two attention actions independently.
ENABLE_ATTENTION_SOUND=true
ENABLE_ATTENTION_COMMAND=true

# Gain applied to the sound file itself via `afplay -v`. 1.0 is unity;
# pushing much past ~2 tends to just clip/distort rather than get louder.
ATTENTION_SOUND_GAIN=1.5

# If true, temporarily raises macOS's system-wide OUTPUT volume to
# SYSTEM_VOLUME_LEVEL right before playback and restores your previous level
# immediately after — so a quiet system volume can't defeat the reminder.
# Off by default in lib/common.sh, but on here since a loud reminder is the
# whole point of this tool; set to false if you'd rather it never touch your
# system volume.
FORCE_SYSTEM_VOLUME=true
SYSTEM_VOLUME_LEVEL=85

# How often (seconds, fractional allowed) the background timer checks for a
# response. Lower = more responsive cancellation, more wakeups.
POLL_INTERVAL=0.5

# Max seconds ATTENTION_COMMAND may run before being killed.
COMMAND_TIMEOUT=15

# Where logs and per-session lock/activity state live. Relative paths are
# resolved from the project root.
LOG_FILE=./logs/permission-alarm.log
STATE_DIR=./state

# Set to true to log the raw JSON payload of every hook event to LOG_FILE.
# Useful for confirming the exact fields your Claude Code version sends.
# Leave false in normal use — it's a debugging aid only.
DEBUG_LOG_PAYLOAD=false

# Backup cancellation signal: also cancel the timer if system-wide physical
# keyboard/mouse input resumes after the prompt appeared. Off by default —
# on a machine you're actively using for something else, this can cancel the
# reminder even though you never looked at the actual prompt. The precise
# signal (the next PreToolUse/PermissionDenied hook for this session, i.e.
# you actually answered) is always on and cannot be disabled.
ENABLE_IDLE_FALLBACK_CANCEL=false
